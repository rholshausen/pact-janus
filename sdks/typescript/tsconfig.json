{
  "$comment": "test/frameworks is a user's project, which imports the built package by its name; test/frameworks.test.ts builds it and runs them.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vitest.config.ts",
    "eslint.config.ts"
  ],
  "exclude": ["test/frameworks"]
}

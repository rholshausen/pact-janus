{
  "consumer": {
    "name": "Consumer"
  },
  "interactions": [
    {
      "description": "a request to fetch current time",
      "request": {
        "method": "GET",
        "path": "/v2/current-time"
      },
      "response": {
        "body": "100",
        "headers": {
          "content-type": "text/plain"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\d+"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "TextBodyTest"
  }
}

{
  "consumer": {
    "name": "consumer"
  },
  "interactions": [
    {
      "description": "a new user",
      "request": {
        "body": {
          "id": 100
        },
        "generators": {
          "body": {
            "$.id": {
              "max": 2147483647,
              "min": 0,
              "type": "RandomInt"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/users"
      },
      "response": {
        "status": 204
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "provider2"
  }
}

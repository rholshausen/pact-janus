{
  "consumer": {
    "name": "test_consumer"
  },
  "interactions": [
    {
      "description": "get all users for max",
      "providerStates": [
        {
          "name": "a user with an id named 'user' exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/idm/user"
      },
      "response": {
        "body": [
                    [
            {
              "email": "string",
              "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
              "userName": "string"
            }
          ]
        ],
        "generators": {
          "body": {
            "$[0][*].email": {
              "size": 20,
              "type": "RandomString"
            },
            "$[0][*].id": {
              "type": "Uuid"
            },
            "$[0][*].userName": {
              "size": 20,
              "type": "RandomString"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$[0]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "max": 5
                }
              ]
            },
            "$[0][*].email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[0][*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$[0][*].userName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },

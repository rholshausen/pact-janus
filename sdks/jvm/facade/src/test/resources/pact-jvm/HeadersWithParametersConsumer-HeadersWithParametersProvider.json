      "response": {
        "headers": {
          "Content-Security-Policy": "default-src: 'none'; frame-ancestors 'none'; base-uri 'self'",
          "strict-transport-security": "max-age=3600; includeSubDomains; reload"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "HeadersWithParametersProvider"
  }
}

{
  "consumer": {
    "name": "test_consumer"
  },
  "interactions": [
    {
      "description": "get all users for max",
      "providerStates": [
        {
          "name": "a user with an id named 'user' exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/idm/user"
      },
      "response": {
        "body": [
          {
            "email": "bob@bobville",
            "id": "7b374cc6-d644-11eb-a613-4ffac1365f0e",
            "userName": "Bob"
          }
        ],
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "max": 5
                }
              ]
            },
            "$[*].email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$[*].userName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "A request with double precision number",
      "providerStates": [
        {
          "name": "test state"
        }
      ],
      "request": {
        "body": {
          "data": 1234.0,
          "name": "harry"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "PUT",
        "path": "/numbertest"
      },
      "response": {
        "body": {
          "data": 1234.0,
          "name": "harry",
          "responsetest": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "multitest_provider"
  }
}

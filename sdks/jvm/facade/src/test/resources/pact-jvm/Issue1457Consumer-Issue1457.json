{
  "consumer": {
    "name": "Issue1457Consumer"
  },
  "interactions": [
    {
      "description": "A request to get USA code",
      "request": {
        "method": "GET",
        "path": "/code/USA"
      },
      "response": {
        "body": "United States",
        "headers": {
          "Content-Type": "text/plain"
        },
        "status": 200
      }
    },
    {
      "description": "A request to get other code",
      "request": {
        "method": "GET",
        "path": "/code/other"
      },
      "response": {
        "body": "Other",
        "headers": {
          "Content-Type": "text/plain"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Issue1457"
  }
}

{
  "consumer": {
    "name": "FormPostConsumer"
  },
  "interactions": [
    {
      "description": "FORM POST request",
      "request": {
        "body": "id=e2490de5-5bd3-43d5-b7c4-526e33f71304&value=1&value=2&value=3",
        "generators": {
          "body": {
            "$.id": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded; charset=ISO-8859-1"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.value": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\d+"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/form"
      },
      "response": {
        "status": 200
      }
    },
    {
      "description": "FORM POST request with provider state",
      "providerStates": [
        {
          "name": "provider state 1"
        }
      ],
      "request": {
        "body": "value=1000",
        "generators": {
          "body": {
            "$.value": {
              "dataType": "STRING",
              "expression": "value",
              "type": "ProviderState"
            }
          }
        },
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded; charset=ISO-8859-1"
        },
        "method": "POST",
        "path": "/form"
      },
      "response": {
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "FormPostProvider"
  }
}

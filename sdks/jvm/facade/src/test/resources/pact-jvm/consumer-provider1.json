{
  "consumer": {
    "name": "consumer"
  },
  "interactions": [
    {
      "description": "a new user request",
      "request": {
        "body": {
          "name": "bob"
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/users"
      },
      "response": {
        "headers": {
          "Location": "http://g:4067/user/6443859873774367"
        },
        "matchingRules": {
          "header": {
            "Location": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "http(s)?://\\w+:\\d{4}/user/\\d{16}"
                }
              ]
            }
          }
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "provider1"
  }
}

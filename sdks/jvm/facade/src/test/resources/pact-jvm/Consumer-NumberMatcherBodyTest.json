{
  "consumer": {
    "name": "Consumer"
  },
  "interactions": [
    {
      "description": "a request to fetch a number",
      "request": {
        "body": {
          "num": 12345
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.num": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                },
                {
                  "match": "regex",
                  "regex": "\\d{5}"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/path"
      },
      "response": {
        "body": {
          "num": 100.02
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.num": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                },
                {
                  "match": "regex",
                  "regex": "\\d+\\.\\d{2}"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "NumberMatcherBodyTest"
  }
}

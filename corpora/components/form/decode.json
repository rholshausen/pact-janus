{
  "name": "form/decode",
  "component": "form",
  "interface": "content",
  "calls": [
    {
      "op": "content/decode",
      "body": {
        "content-type": "application/x-www-form-urlencoded",
        "value": {
          "content": "YT0xJmI9dHdvK3dvcmRzJmE9MyZjPSUyNg==",
          "encoded": "base64"
        }
      },
      "expect": {
        "ok": {
          "document": {
            "a": [
              "1",
              "3"
            ],
            "b": [
              "two words"
            ],
            "c": [
              "&"
            ]
          }
        }
      }
    },
    {
      "op": "content/decode",
      "body": {
        "content-type": "application/x-www-form-urlencoded",
        "value": {
          "content": "z=1&y=",
          "encoded": "text"
        }
      },
      "expect": {
        "ok": {
          "document": {
            "z": [
              "1"
            ],
            "y": [
              ""
            ]
          }
        }
      }
    },
    {
      "op": "content/decode",
      "body": {
        "content-type": "application/x-www-form-urlencoded",
        "value": {
          "content": {
            "a": [
              "1"
            ]
          }
        }
      },
      "expect": {
        "ok": {
          "document": {
            "a": [
              "1"
            ]
          }
        }
      }
    }
  ]
}

                "content-type": "application/json"
              }
            },
            {
              "id": "2",
              "content-type": "application/octet-stream",
              "value": {
                "content": "AAE=",
                "encoded": "base64",
                "content-type": "application/octet-stream"
              }
            }
          ]
        }
      }
    },
    {
      "op": "content/decode",
      "body": {
        "content-type": "multipart/form-data; boundary=b",
        "value": {
          "content": "",
          "encoded": "base64"
        },
        "embedded": {
          "0": {
            "document": {
              "a": 1
            }
          },
          "2": {
            "document": "AAE=",
            "encoded": "base64"

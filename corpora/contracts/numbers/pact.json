{
  "consumer": { "name": "number-consumer" },
  "provider": { "name": "number-provider" },
  "interactions": [
    {
      "description": "every way a number is written",
      "request": { "method": "GET", "path": "/numbers" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": {
          "integer": 42,
          "negative-integer": -5,
          "zero": 0,
          "above-2-to-the-53": 9007199254740993,
          "largest-unsigned-64-bit": 18446744073709551615,
          "smallest-signed-64-bit": -9223372036854775808,
          "beyond-64-bits": 18446744073709551616,
          "beyond-a-double": 123456789012345678901234567890,
          "integral-double": 1.0,
          "hundred": 100.0,
          "exponent-spelled-hundred": 1E2,
          "trailing-zero": 1.10,
          "tenth": 0.1,
          "smallest-positional": 0.00001,
          "largest-exponent-form-below-one": 1e-6,
          "small-with-a-fraction": 1.5e-7,
          "largest-positional": 1e15,
          "smallest-exponent-form-above-one": 1e16,
          "large": 1e21,
          "smallest-double": 5e-324,
          "largest-double": 1.7976931348623157e308,
          "double-zero": 0.0,
          "negative-zero": -0.0,
          "negative-zero-as-an-integer": -0
        }
      }
    }
  ],
  "metadata": { "pactSpecification": { "version": "3.0.0" } }
}

{
  "description": "a header's rule applies to each of its values, as today's verifier applies it (ADR 0082 decision 6): the reply sends X-TEST twice, 1 and 1000, and each matches \\d{1,4}, where their join '1, 1000' would not",
  "input": {
    "kind": "pact-interaction",
    "pact": {
      "consumer": {
        "name": "consumer"
      },
      "provider": {
        "name": "provider"
      },
      "interactions": [
        {
          "description": "get the test header",
          "request": {
            "method": "GET",
            "path": "/one"
          },
          "response": {
            "status": 200,
            "headers": {
              "X-TEST": "1"
            },
            "matchingRules": {
              "$.headers.X-TEST": {
                "match": "regex",
                "regex": "\\d{1,4}"
              }
            }
          }
        }
      ],
      "metadata": {
        "pactSpecification": {
          "version": "2.0.0"
        }
      }
    },
    "index": 0
  },
  "values": {
    "$.request.method": "GET",
    "$.request.path": "/one",
    "$.request.query": {},
    "$.response.status": 200,
    "$.response.headers.x-test": [
      "1",
      "1000"
    ]
  },
  "result": {
    "status": "matched"
  }
}

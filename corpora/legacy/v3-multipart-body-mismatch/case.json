          "description": "post /upload",
          "request": {
            "method": "POST",
            "path": "/upload",
            "headers": {
              "Content-Type": "multipart/form-data; boundary=b"
            },
            "body": "--b\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nMary\r\n--b\r\nContent-Disposition: form-data; name=\"order\"; filename=\"order.json\"\r\nContent-Type: application/json\r\nX-Version: 2\r\n\r\n{\"id\": 1}\r\n--b\r\nContent-Disposition: form-data; name=\"note\"; filename=\"note.txt\"\r\nContent-Type: text/plain\r\n\r\nhello\r\n--b\r\nContent-Disposition: form-data; name=\"logo\"; filename=\"logo.png\"\r\nContent-Type: image/png\r\n\r\nPNG\r\n--b--\r\n"
          },
          "response": {
            "status": 201
          }
        }
      ],
      "metadata": {
        "pactSpecification": {
          "version": "3.0.0"
        }
      }
    },
    "index": 0
  },
  "values": {
    "$.request.method": "POST",
    "$.request.path": "/upload",
    "$.request.query": {},
    "$.request.headers.content-type": "multipart/form-data; boundary=b",
    "$.request.body": {
      "name": [
        {
          "headers": {
            "content-disposition": "form-data; name=\"name\"; filename=\"n.txt\""
          },
          "filename": "n.txt",
          "body": "Mary"
        }
      ],
      "order": [
        {
          "headers": {
            "content-disposition": "form-data; name=\"order\"; filename=\"o.json\"",
            "content-type": "application/json"
          },
          "filename": "o.json",
          "body": {
            "id": 1,
            "extra": 2
          }
        }
      ],
      "logo": [
        {
          "headers": {
            "content-disposition": "form-data; name=\"logo\"; filename=\"logo.gif\"",
            "content-type": "image/gif"
          },
          "filename": "logo.gif",
          "body": "GIF"
        }
      ]
    },
    "$.response.status": 201
  },
  "result": {
    "status": "mismatched",
    "mismatches": [

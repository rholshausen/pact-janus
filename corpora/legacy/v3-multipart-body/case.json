    "pact": {
      "consumer": {
        "name": "consumer"
      },
      "provider": {
        "name": "provider"
      },
      "interactions": [
        {
          "description": "get /upload",
          "request": {
            "method": "GET",
            "path": "/upload"
          },
          "response": {
            "status": 200,
            "headers": {
              "Content-Type": "multipart/form-data; boundary=b"
            },
            "body": "--b\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nMary\r\n--b\r\nContent-Disposition: form-data; name=\"order\"; filename=\"order.json\"\r\nContent-Type: application/json\r\n\r\n{\"id\": 1, \"items\": [\"apple\"]}\r\n--b\r\nContent-Disposition: form-data; name=\"note\"; filename=\"note.xml\"\r\nContent-Type: application/xml\r\n\r\n<note lang=\"en\">hi</note>\r\n--b--\r\n",
            "matchingRules": {
              "header": {
                "Content-Type": {
                  "matchers": [
                    {
                      "match": "regex",
                      "regex": "multipart/form-data; boundary=.*"
                    }
                  ]
                }
              },
              "body": {
                "$.name": {
                  "matchers": [
                    {
                      "match": "regex",
                      "regex": "[A-Z][a-z]+"
                    }
                  ]
                },
                "$.order.id": {
                  "matchers": [
                    {
                      "match": "integer"
                    }
                  ]
                },
                "$.order.items": {
                  "matchers": [
                    {
                      "match": "type"
                    }
                  ]
                },
                "$.note.note['@lang']": {
                  "matchers": [
                    {
                      "match": "regex",
                      "regex": "[a-z]{2}"
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "metadata": {
        "pactSpecification": {
          "version": "3.0.0"
        }
      }
    },
    "index": 0
  },

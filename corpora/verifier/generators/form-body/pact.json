{
  "consumer": {
    "name": "web-app"
  },
  "provider": {
    "name": "order-service"
  },
  "interactions": [
    {
      "description": "an order placed from a form",
      "providerStates": [
        {
          "name": "a customer exists"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/orders",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "customer=1&qty=2&note=gift+wrap",
        "generators": {
          "body": {
            "$.customer": {
              "type": "ProviderState",
              "expression": "${customer}",
              "dataType": "STRING"
            },
            "$.qty": {
              "type": "RandomInt",
              "min": 100,
              "max": 999
            }
          }
        }
      },
      "response": {
        "status": 201
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}

      "description": "a body generated by RandomInt",
      "request": {
        "method": "POST",
        "path": "/generators/random-int",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "one": "a",
          "two": "b"
        },
        "generators": {
          "body": {
            "$.one": {
              "type": "RandomInt",
              "min": 0,
              "max": 1000
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "ok": true
        }

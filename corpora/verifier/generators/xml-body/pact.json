{
  "consumer": {
    "name": "web-app"
  },
  "provider": {
    "name": "order-service"
  },
  "interactions": [
    {
      "description": "an order placed as XML",
      "providerStates": [
        {
          "name": "a customer exists"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/orders",
        "headers": {
          "Content-Type": "application/xml"
        },
        "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><order customer=\"1\"><note>for 1</note><qty>2</qty></order>",
        "generators": {
          "body": {
            "$.order['@customer']": {
              "type": "ProviderState",
              "expression": "${customer}",
              "dataType": "STRING"
            },
            "$.order.note['#text']": {
              "type": "ProviderState",
              "expression": "for ${customer}",
              "dataType": "STRING"
            }
          }
        }
      },
      "response": {
        "status": 201
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}

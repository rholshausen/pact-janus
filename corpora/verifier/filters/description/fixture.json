{
  "description": "--filter-description: only the interactions whose description the regular expression is found in. Both verifiers verify the two order requests and leave the health check out",
  "source": "staged plan S1.13; pact_verifier's FilterInfo and filter_consumers",
  "pacts": [
    "pact.json"
  ],
  "provider": {
    "kind": "scripted",
    "state-callback": "ok",
    "routes": [
      {
        "states": [
          "an order exists"
        ],
        "request": {
          "method": "GET",
          "path": "/orders/1"
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": [
              "application/json"
            ]
          },
          "body": {
            "json": {
              "id": "1"
            }
          }
        }
      },
      {
        "states": [
          "no orders"
        ],
        "request": {
          "method": "GET",
          "path": "/orders/2"
        },
        "response": {
          "status": 404
        }
      },
      {
        "request": {
          "method": "GET",
          "path": "/health"
        },
        "response": {
          "status": 200
        }
      }
    ]
  },
  "filter": {
    "description": "order"
  }
}

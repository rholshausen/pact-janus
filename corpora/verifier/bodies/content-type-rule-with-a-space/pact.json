{
  "consumer": {
    "name": "bodies-consumer"
  },
  "provider": {
    "name": "bodies-provider"
  },
  "interactions": [
    {
      "description": "an order",
      "request": {
        "method": "GET",
        "path": "/order"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "body": {
          "id": 1
        },
        "matchingRules": {
          "header": {
            "Content-Type": {
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json; charset=.+"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
}

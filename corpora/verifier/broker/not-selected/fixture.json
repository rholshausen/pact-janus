{
  "description": "A pact on a branch the selectors do not name, with work in progress off, is not fetched: nothing verifies it and nothing is published for it",
  "source": {
    "semantics": "https://docs.pact.io/pact_broker/advanced_topics/consumer_version_selectors"
  },
  "pacts": [
    "../pacts/widget-web.json",
    "../pacts/widget-admin.json"
  ],
  "provider": {
    "kind": "scripted",
    "state-callback": "none",
    "routes": [
      {
        "request": {
          "method": "GET",
          "path": "/widgets/1"
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": [
              "application/json"
            ]
          },
          "body": {
            "json": {
              "id": 1,
              "name": "sprocket"
            }
          }
        }
      }
    ]
  },
  "expected": "pass",
  "broker": {
    "publish": {
      "widget-admin.json": {
        "branch": "feature-colour"
      }
    },
    "verify": {
      "selectors": [
        {
          "mainBranch": true
        }
      ],
      "provider-version": "2.0.0",
      "provider-branch": "main",
      "publish": true
    },
    "expected-published": {
      "widget-web.json": "pass",
      "widget-admin.json": "absent"
    }
  }
}

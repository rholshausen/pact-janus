{
  "consumer": {
    "name": "matching-rules-consumer"
  },
  "provider": {
    "name": "matching-rules-provider"
  },
  "interactions": [
    {
      "type": "Synchronous/HTTP",
      "key": "chips",
      "description": "chips by name, every amount an integer",
      "request": {
        "method": "GET",
        "path": "/chips"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "body": {
          "content": {
            "chips": {
              "main": {
                "amount": 1000
              }
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.chips": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "eachValue",
                  "rules": [
                    {
                      "match": "type"
                    }
                  ],
                  "value": "{\"main\":{\"amount\":1000}}"
                }
              ]
            },
            "$.chips.*.amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "Synchronous/HTTP",

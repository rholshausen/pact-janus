{
  "consumer": {
    "name": "matching-rules-consumer"
  },
  "provider": {
    "name": "matching-rules-provider"
  },
  "interactions": [
    {
      "type": "Synchronous/HTTP",
      "key": "prices",
      "description": "prices by fruit",
      "request": {
        "method": "GET",
        "path": "/prices"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "body": {
          "content": {
            "prices": {
              "apple": 1.5
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.prices": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "eachValue",
                  "rules": [
                    {
                      "match": "type"
                    }
                  ],
                  "value": "1.5"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "Synchronous/HTTP",
      "key": "prices-bad",
      "description": "prices by fruit, one a string",
      "request": {
        "method": "GET",
        "path": "/prices/bad"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "body": {
          "content": {
            "prices": {
              "apple": 1.5
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.prices": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "eachValue",
                  "rules": [
                    {
                      "match": "type"
                    }
                  ],
                  "value": "1.5"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "Synchronous/HTTP",
      "key": "ids",
      "description": "ids",
      "request": {
        "method": "GET",
        "path": "/ids"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "body": {
          "content": {
            "ids": [
              "a1"
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.ids": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "eachValue",
                  "rules": [
                    {
                      "match": "regex",
                      "regex": "[a-z][0-9]"
                    }
                  ],
                  "value": "a1"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "Synchronous/HTTP",
      "key": "ids-bad",
      "description": "ids, one not an id",
      "request": {
        "method": "GET",
        "path": "/ids/bad"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "body": {
          "content": {
            "ids": [
              "a1"
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.ids": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "eachValue",
                  "rules": [
                    {
                      "match": "regex",
                      "regex": "[a-z][0-9]"
                    }
                  ],
                  "value": "a1"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "4.0"
    }
  }
}

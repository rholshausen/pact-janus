{
  "consumer": {
    "name": "matching-rules-consumer"
  },
  "provider": {
    "name": "matching-rules-provider"
  },
  "interactions": [
    {
      "type": "Synchronous/HTTP",
      "key": "items",
      "description": "items",
      "request": {
        "method": "GET",
        "path": "/items"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "body": {
          "content": {
            "items": [
              {
                "id": 1,
                "kind": "book"
              },
              {
                "id": 2,
                "kind": "pen"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "arrayContains",
                  "variants": [
                    {
                      "index": 0,
                      "rules": {
                        "$.id": {
                          "combine": "AND",
                          "matchers": [
                            {
                              "match": "integer"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "index": 1,
                      "rules": {
                        "$.id": {
                          "combine": "AND",
                          "matchers": [
                            {
                              "match": "integer"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "Synchronous/HTTP",
      "key": "items-bad",
      "description": "items, one variant not there",

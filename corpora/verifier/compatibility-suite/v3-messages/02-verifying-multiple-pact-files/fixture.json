    "routes": [
      {
        "request": {
          "body": {
            "json": {
              "description": "basic"
            }
          },
          "method": "POST",
          "path": "/"
        },
        "response": {
          "body": {
            "json": {
              "one": "a",
              "two": "b"
            }
          },
          "headers": {
            "Content-Type": [
              "application/json"
            ],
            "Pact-Message-Metadata": [
              "eyJjb250ZW50VHlwZSI6ImFwcGxpY2F0aW9uL2pzb24ifQ=="

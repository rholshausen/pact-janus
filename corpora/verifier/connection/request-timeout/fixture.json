{
  "description": "A provider that takes a second to answer fails a request bounded by --request-timeout 300",
  "source": "staged plan S1.5; pact_verifier_cli's provider options, which janus verify spells the same way; ADR 0035",
  "pacts": [
    "pact.json"
  ],
  "connection": {
    "request-timeout": 300
  },
  "provider": {
    "kind": "scripted",
    "state-callback": "none",
    "routes": [
      {
        "request": {
          "method": "GET",
          "path": "/orders/1"
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": [
              "application/json"
            ]
          },
          "body": {
            "json": {
              "id": 1
            }
          },
          "delay-ms": 1000
        }
      }
    ]
  },
  "expected": "fail"
}

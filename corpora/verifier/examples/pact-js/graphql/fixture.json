{
  "description": "pact-js examples/graphql: a GraphQL query over HTTP. The provider answers as the example's own provider does, as recorded from it",
  "source": "pact-js examples/graphql (MIT) at 8a8f27a: the pact consumer.test.ts writes, and provider.ts's answers to it. Staged plan S1.15; ADR 0056 decision 5; the TypeScript SDK's test/examples verify the same pact through pact-janus/verifier",
  "pacts": [
    "pact.json"
  ],
  "provider": {
    "kind": "scripted",
    "state-callback": "ok",
    "routes": [
      {
        "states": [
          "the hello service is available"
        ],
        "request": {
          "method": "POST",
          "path": "/graphql",
          "headers": {
            "Content-Type": [
              "application/json"
            ]
          },
          "body": {
            "json": {
              "operationName": "HelloQuery",
              "query": "\n        query HelloQuery {\n          hello\n        }\n      ",
              "variables": {
                "name": "World"
              }
            }
          }
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": [
              "application/json; charset=utf-8"
            ]
          },
          "body": {
            "json": {
              "data": {
                "hello": "Hello, World!"
              }
            }
          }
        }
      }
    ]
  },
  "expected": "pass"
}

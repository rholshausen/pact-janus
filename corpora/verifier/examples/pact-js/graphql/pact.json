{
  "consumer": {
    "name": "GraphQLConsumer"
  },
  "interactions": [
    {
      "description": "a HelloQuery request",
      "pending": false,
      "providerStates": [
        {
          "name": "the hello service is available"
        }
      ],
      "request": {
        "body": {
          "content": {
            "operationName": "HelloQuery",
            "query": "\n        query HelloQuery {\n          hello\n        }\n      ",
            "variables": {
              "name": "World"
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.query": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\s*query\\s*HelloQuery\\s*\\{\\s*hello\\s*\\}\\s*"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/graphql"
      },
      "response": {
        "body": {
          "content": {
            "data": {
              "hello": "Hello, World!"
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=utf-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.data.hello": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "GraphQLProvider"
  }
}
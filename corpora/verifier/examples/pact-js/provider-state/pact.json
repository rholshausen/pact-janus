{
  "consumer": {
    "name": "AccountConsumer"
  },
  "interactions": [
    {
      "description": "a GET request for account ACC-001",
      "providerStates": [
        {
          "name": "an account with number {accountNumber} exists",
          "params": {
            "accountNumber": "ACC-001"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/accounts/ACC-001"
      },
      "response": {
        "body": {
          "accountNumber": "ACC-001",
          "balance": 1000,
          "id": 42,
          "ownerName": "Jane Smith"
        },
        "generators": {
          "body": {
            "$.id": {
              "expression": "${accountId}",
              "type": "ProviderState"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.accountNumber": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.balance": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.ownerName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "AccountService"
  }
}
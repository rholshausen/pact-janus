{
  "consumer": {
    "name": "CatalogueConsumer"
  },
  "interactions": [
    {
      "description": "a GET request for the catalogue in XML",
      "pending": false,
      "providerStates": [
        {
          "name": "the catalogue has books"
        }
      ],
      "request": {
        "headers": {
          "Accept": [
            "application/xml"
          ]
        },
        "method": "GET",
        "path": "/catalogue"
      },
      "response": {
        "body": {
          "content": "<?xml version='1.0'?><catalogue><book><title>The Pragmatic Programmer</title><author>David Thomas</author></book></catalogue>",
          "contentType": "application/xml",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/xml; charset=utf-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.catalogue.book": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.catalogue.book.author.#text": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.catalogue.book.title.#text": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "CatalogueService"
  }
}
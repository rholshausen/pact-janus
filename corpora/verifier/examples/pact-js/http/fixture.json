{
  "description": "pact-js examples/http: UserConsumer's pact and the User Service, whose state handlers seed the users. The provider answers as the example's own provider does, as recorded from it",
  "source": "pact-js examples/http (MIT) at 8a8f27a: the pact consumer.test.ts writes, and provider.ts's answers to it. Staged plan S1.15; ADR 0056 decision 5; the TypeScript SDK's test/examples verify the same pact through pact-janus/verifier",
  "pacts": [
    "pact.json"
  ],
  "provider": {
    "kind": "scripted",
    "state-callback": "ok",
    "routes": [
      {
        "states": [
          "users exist"
        ],
        "request": {
          "method": "GET",
          "path": "/users",
          "headers": {
            "Accept": [
              "application/json"
            ]
          }
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": [
              "application/json; charset=utf-8"
            ]
          },
          "body": {
            "json": [
              {
                "id": 1,
                "name": "Alice",
                "email": "alice@example.com"
              },
              {
                "id": 2,
                "name": "Bob",
                "email": "bob@example.com"
              }
            ]
          }
        }
      },
      {
        "states": [
          "a user with ID 1 exists"
        ],
        "request": {
          "method": "GET",
          "path": "/users/1",
          "headers": {
            "Accept": [
              "application/json"
            ]
          }
        },
        "response": {
          "status": 200,
          "headers": {
            "Content-Type": [
              "application/json; charset=utf-8"
            ]
          },
          "body": {
            "json": {
              "id": 1,
              "name": "Alice",
              "email": "alice@example.com"
            }
          }
        }
      }
    ]
  },
  "expected": "pass"
}

        }
      ],
      "parts": {
        "request": {
          "method": {
            "shape": "equality",
            "example": "GET"
          },
          "path": {
            "shape": "http:path",
            "template": "/orders/{id}",
            "example": "/orders/1"
          }
        }
      }
    }
  },
  "values": {
    "$.request.method": "GET",
    "$.request.path": "/orders/66"
  },
  "result": {

{
  "description": "a request list pinned to min+1 admits any length above the minimum, not exactly min+1 (ADR 0024, phase-9 finding 25)",
  "input": {
    "kind": "spec",
    "spec": {
      "description": "submit a batch of orders",
      "parts": {
        "request": {
          "body": {
            "shape": "each-like",
            "items": {
              "shape": "object",
              "members": {
                "sku": { "shape": "string", "example": "SKU-1" },
                "qty": { "shape": "integer", "example": 1 }
              }
            }
          }
        }
      }
    },
    "variant": "request.body#cardinality=min+1"
  },
  "values": {
    "$.request.body": [
      { "sku": "SKU-1", "qty": 1 },
      { "sku": "SKU-2", "qty": 4 },
      { "sku": "SKU-3", "qty": 2 }
    ]
  },
  "result": {
    "status": "matched"
  }
}

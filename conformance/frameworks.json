    "jest-esm": {
      "language": "typescript",
      "subject": ".test.mjs",
      "style": { "guide": "sdks/typescript/STYLE.md", "sections": ["Test-framework integration"] }
    },
    "vitest": {
      "language": "typescript",
      "subject": ".test.ts",
      "style": { "guide": "sdks/typescript/STYLE.md", "sections": ["Test-framework integration"] }
    },
    "junit5": {
      "language": "jvm",
      "subject": ".java",
      "style": {
        "guide": "sdks/jvm/STYLE.md",
        "sections": ["Test-framework integration", "Provider test-framework integration"]
      }
    },
    "spock": {
      "language": "jvm",
      "subject": ".groovy",

{
  "$format": "janus-conformance-case/1",
  "id": "translation/kind-predicates",
  "category": "translation",
  "title": "Each kind-predicate helper emits its own operator with the example it was given.",
  "covers": ["shape.integer.kind-predicate", "shape.number.kind-predicate", "shape.decimal.kind-predicate", "shape.string.kind-predicate", "shape.boolean.kind-predicate"],
  "why": "behavioural spec 'integer', 'number', 'decimal', 'string', 'boolean': each compiles to its kind predicate (shape spec §4.2) with 'example' as its example, and contributes no variant dimension.",
  "interaction": {
    "description": "one of every kind predicate",
    "response": {
      "body": {
        "qty": { "$": "integer", "args": [3] },
        "weight": { "$": "number", "args": [1.5] },
        "total": { "$": "decimal", "args": [9.99] },
        "sku": { "$": "string", "args": ["SKU-1"] },
        "paid": { "$": "boolean", "args": [true] }
      }
    }
  },
  "expect": {
    "at": {
      "/parts/response/body": {
        "shape": "object",
        "members": {
          "qty": { "shape": "integer", "example": 3 },
          "weight": { "shape": "number", "example": 1.5 },
          "total": { "shape": "decimal", "example": 9.99 },
          "sku": { "shape": "string", "example": "SKU-1" },
          "paid": { "shape": "boolean", "example": true }
        }
      }
    }
  }
}

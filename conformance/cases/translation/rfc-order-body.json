{
  "$format": "janus-conformance-case/1",
  "id": "translation/rfc-order-body",
  "category": "translation",
  "title": "The RFC's consumer example builds the shape-language design's canonical order payload.",
  "covers": ["shape.literal.helper-used-as-authored", "shape.any-of.literal-containment", "shape.one-of.discriminator-binding", "shape.optional.wraps-any-operator", "shape.each-like.bounds-only-when-given"],
  "why": "SDK spec §4's worked reference: the RFC's consumer example, primitive by primitive. The body is the shape-language design's own canonical order payload (examples/order-payload.md §2), which corpora/shapes/order-payload/ compiles and executes.",
  "note": "Two members of that canonical shape are hand-written there and are not the DSL's to add: 'datetime'/'date' formats (never inferred from the example) and the one-of's 'default' (absent means the engine's rule). The shape below is the payload without them.",
  "interaction": {
    "description": "get an order",
    "given": [{ "name": "an order exists", "params": { "id": "42" } }],
    "request": { "method": "GET", "path": "/orders/42" },
    "response": {
      "status": 200,
      "body": {
        "$": "json",
        "args": [
          {
            "id": { "$": "integer", "args": [42] },
            "status": { "$": "any-of", "args": ["PENDING", "SHIPPED", "DELIVERED"] },
            "shippedAt": { "$": "optional", "args": [{ "$": "datetime", "args": ["2026-07-30T10:00:00Z"] }] },
            "payment": {
              "$": "one-of",
              "args": [
                "type",
                {
                  "card": { "type": "card", "last4": { "$": "regex", "args": ["\\d{4}", "1234"] } },
                  "invoice": { "type": "invoice", "dueDate": { "$": "date", "args": ["2026-08-30"] } }
                }
              ]
            },
            "items": {
              "$": "each-like",
              "args": [{ "sku": { "$": "string", "args": ["SKU-1"] }, "qty": { "$": "integer", "args": [1] } }],
              "options": { "min": 1 }
            }
          }
        ]
      }
    }
  },
  "expect": {
    "spec": {
      "description": "get an order",
      "transport": { "kind": "http", "mode": "passive" },
      "states": [{ "name": "an order exists", "params": { "id": "42" } }],
      "parts": {
        "request": {
          "method": { "shape": "equality", "example": "GET" },
          "path": { "shape": "equality", "example": "/orders/42" }
        },
        "response": {
          "status": { "shape": "equality", "example": 200 },
          "body": {
            "shape": "object",
            "members": {
              "id": { "shape": "integer", "example": 42 },
              "status": { "shape": "any-of", "options": ["PENDING", "SHIPPED", "DELIVERED"], "example": "PENDING" },
              "shippedAt": { "shape": "optional", "of": { "shape": "datetime", "example": "2026-07-30T10:00:00Z" } },
              "payment": {
                "shape": "one-of",
                "discriminator": "type",
                "alternatives": {
                  "card": {
                    "shape": "object",
                    "members": {
                      "type": { "shape": "equality", "example": "card" },
                      "last4": { "shape": "regex", "pattern": "\\d{4}", "example": "1234" }
                    }
                  },
                  "invoice": {
                    "shape": "object",
                    "members": {
                      "type": { "shape": "equality", "example": "invoice" },
                      "dueDate": { "shape": "date", "example": "2026-08-30" }
                    }
                  }
                }
              },
              "items": {
                "shape": "each-like",
                "min": 1,
                "items": {
                  "shape": "object",
                  "members": {
                    "sku": { "shape": "string", "example": "SKU-1" },
                    "qty": { "shape": "integer", "example": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

              "path": "/orders/42"
            },
            "response": {
              "status": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": 42
              }
            }
          }
        ],
        "metadata": {
          "pactSpecification": {
            "version": "3.0.0"
          }
        }
      }

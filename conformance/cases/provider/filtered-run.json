{
  "$format": "janus-conformance-case/1",
  "id": "provider/filtered-run",
  "category": "provider",
  "title": "A filtered run does not fail verify, and its result says filtered",
  "covers": [
    "verification.verify.filtered-is-not-verified"
  ],
  "why": "behavioural spec 'verify': 'a filtered run is not a failure, and its status says filtered, never verified' (ADR 0041, ADR 0055 decision 1).",
  "verifier": {
    "provider-url": "http://127.0.0.1:8080",
    "pacts": [
      {
        "consumer": {
          "name": "web-app"
        },
        "provider": {
          "name": "orders-api"
        },
        "interactions": [
          {
            "description": "get an order",
            "providerStates": [
              {
                "name": "an order exists",
                "params": {
                  "id": 42
                }
              }
            ],
            "request": {
              "method": "GET",
              "path": "/orders/42"
            },
            "response": {
              "status": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": 42
              }
            }
          }
        ],
        "metadata": {
          "pactSpecification": {
            "version": "3.0.0"
          }
        }
      }
    ],
    "options": {
      "filter": {
        "description": "get an order"
      }
    }
  },
  "engine": {
    "summary": {
      "status": "filtered",
      "filtered": true,
      "variants": {
        "verified": 1,
        "failed": 0
      }
    }
  },
  "expect": {
    "outcome": "ok",
    "result": {
      "status": "filtered",
      "results": [
        {
          "interaction": {
            "contract": {
              "consumer": "web-app",
              "provider": "orders-api"
            },
            "index": 0,
            "description": "get an order"
          },
          "variant": "base",
          "status": "verified"
        }
      ]
    }
  }
}

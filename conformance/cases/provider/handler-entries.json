{
  "$format": "janus-conformance-case/1",
  "id": "provider/handler-entries",
  "category": "provider",
  "title": "Each handler is a loopback hook entry, named by kind and position",
  "covers": [
    "verification.state-handler.entry",
    "verification.state-handler.teardown-entry",
    "verification.request-filter.entry"
  ],
  "why": "behavioural spec 'state-handler' and 'request-filter': 'state-<n>' and 'request-filter-<n>', a 'state-teardown' entry with the same name when there is a teardown, 'changes' the declared slots written 'parts.request.<slot>'.",
  "verifier": {
    "provider-url": "http://127.0.0.1:8080",
    "pacts": [
      {
        "consumer": {
          "name": "web-app"
        },
        "provider": {
          "name": "orders-api"
        },
        "interactions": [
          {
            "description": "get an order",
            "providerStates": [
              {
                "name": "an order exists",
                "params": {
                  "id": 42
                }
              }
            ],
            "request": {
              "method": "GET",
              "path": "/orders/42"
            },
            "response": {
              "status": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": 42
              }
            }
          }
        ],
        "metadata": {
          "pactSpecification": {
            "version": "3.0.0"
          }
        }
      }
    ],
    "state-handlers": [
      {
        "state": "an order exists",
        "setup": {}
      },
      {
        "state": "no orders exist",
        "setup": {},
        "teardown": {}
      }
    ],
    "request-filters": [
      {},
      {
        "changes": [
          "headers",
          "query"
        ]
      }
    ]
  },
  "expect": {
    "hooks": {
      "version": 1,
      "hooks": {
        "state-setup": [
          {
            "name": "state-1",
            "when": {
              "state": "an order exists"
            },
            "run": {
              "kind": "http",
              "url": "loopback:/state-setup/state-1",
              "headers": {
                "authorization": "Bearer <token>"
              }
            }
          },
          {
            "name": "state-2",
            "when": {
              "state": "no orders exist"
            },
            "run": {
              "kind": "http",
              "url": "loopback:/state-setup/state-2",
              "headers": {
                "authorization": "Bearer <token>"
              }
            }
          }
        ],
        "state-teardown": [
          {
            "name": "state-2",
            "when": {
              "state": "no orders exist"
            },
            "run": {
              "kind": "http",
              "url": "loopback:/state-teardown/state-2",
              "headers": {
                "authorization": "Bearer <token>"
              }
            }
          }
        ],
        "before-request": [
          {
            "name": "request-filter-1",
            "changes": [
              "parts.request.headers"
            ],
            "run": {
              "kind": "http",
              "url": "loopback:/before-request/request-filter-1",
              "headers": {
                "authorization": "Bearer <token>"
              }
            }
          },
          {
            "name": "request-filter-2",
            "changes": [
              "parts.request.headers",
              "parts.request.query"
            ],
            "run": {
              "kind": "http",
              "url": "loopback:/before-request/request-filter-2",
              "headers": {
                "authorization": "Bearer <token>"
              }
            }
          }
        ]
      }
    },
    "outcome": "ok"
  }
}

    "observations": [
      {
        "operation": {
          "method": {
            "$": "regex",
            "args": [
              "^(GET|HEAD)$",
              "GET"
            ]
          },
          "path": {
            "$": "path-template",
            "args": [
              "/orders/{id}"
            ]
          }
        },
        "response": {
          "status": 200
        }
      }
    ]
  },
  "expect": {
    "ops": [],
    "observed": [
      {
        "error": "refused"
      }
    ],
    "written": false
  }

{
  "$format": "janus-conformance-case/1",
  "id": "provider/config-loaded-through-engine",
  "category": "provider",
  "title": "A configuration is loaded through the engine, and the handlers follow its hooks",
  "covers": [
    "verification.verify.config-loaded-through-engine",
    "verification.verify.handlers-follow-configuration"
  ],
  "why": "behavioural spec 'verify': send 'config/load' with its path, resolved against the working directory; 'components' the configuration's then the option's; at each point the configuration's entries, then the handlers' (ADR 0055 decision 3).",
  "verifier": {
    "provider-url": "http://127.0.0.1:8080",
    "pacts": [
      {
        "consumer": {
          "name": "web-app"
        },
        "provider": {
          "name": "orders-api"
        },
        "interactions": [
          {
            "description": "get an order",
            "providerStates": [
              {
                "name": "an order exists",
                "params": {
                  "id": 42
                }
              }
            ],
            "request": {
              "method": "GET",
              "path": "/orders/42"
            },
            "response": {
              "status": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": 42
              }
            }
          }
        ],
        "metadata": {
          "pactSpecification": {
            "version": "3.0.0"
          }
        }
      }
    ],
    "config": "version: 1\nhooks: {}\n",
    "components": [
      {
        "name": "csv",
        "source": {
          "kind": "oci",
          "reference": "ghcr.io/acme/janus-csv:1.2.0",
          "digest": "sha256:9f2c"
        }
      }
    ],
    "state-handlers": [
      {
        "state": "an order exists",
        "setup": {}
      }
    ]
  },
  "engine": {
    "config": {
      "version": 1,
      "hooks": {
        "before-verification": [
          {
            "name": "auth-token",
            "run": {
              "kind": "http",
              "url": "https://auth.internal/token"
            }
          }
        ],
        "state-setup": [
          {
            "name": "fixtures",
            "run": {
              "kind": "http",
              "url": "https://fixtures.internal/state"
            }
          }
        ]
      },
      "components": [
        {
          "name": "xml-extra",
          "source": {
            "kind": "oci",
            "reference": "ghcr.io/acme/xml-extra:2.0.0",
            "digest": "sha256:1a2b"
          }
        }
      ]
    }
  },
  "expect": {
    "ops": [
      "engine/hello",
      "config/load",
      "verification/verify",
      "events/poll"
    ],
    "config-loaded": true,
    "frames": {
      "verification/verify": {
        "target": {
          "components": [
            {
              "name": "xml-extra",
              "source": {
                "kind": "oci",
                "reference": "ghcr.io/acme/xml-extra:2.0.0",
                "digest": "sha256:1a2b"
              }
            },
            {
              "name": "csv",
              "source": {
                "kind": "oci",
                "reference": "ghcr.io/acme/janus-csv:1.2.0",
                "digest": "sha256:9f2c"
              }
            }
          ]
        }
      }
    },
    "hooks": {
      "version": 1,
      "hooks": {
        "before-verification": [
          {
            "name": "auth-token",
            "run": {
              "kind": "http",
              "url": "https://auth.internal/token"
            }
          }
        ],
        "state-setup": [
          {
            "name": "fixtures",
            "run": {
              "kind": "http",
              "url": "https://fixtures.internal/state"
            }
          },
          {
            "name": "state-1",
            "when": {
              "state": "an order exists"
            },
            "run": {
              "kind": "http",
              "url": "loopback:/state-setup/state-1",
              "headers": {
                "authorization": "Bearer <token>"
              }
            }
          }
        ]
      }
    },
    "outcome": "ok"
  }
}

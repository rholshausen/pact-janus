{
  "$format": "janus-conformance-case/1",
  "id": "provider/plugin-bridge-as-given",
  "category": "provider",
  "title": "A plugin-bridge the run's options give is sent as given, whatever bridge is named",
  "covers": [
    "verification.verify.plugin-bridge-as-given"
  ],
  "why": "behavioural spec 'verify': 'A caller that gives plugin-bridge in the options is sent what it gave', even with the 'plugin-bridge' option naming another program.",
  "verifier": {
    "provider-url": "http://127.0.0.1:8080",
    "pacts": [
      {
        "consumer": {
          "name": "web-app"
        },
        "provider": {
          "name": "orders-api"
        },
        "interactions": [
          {
            "description": "get an order",
            "providerStates": [
              {
                "name": "an order exists",
                "params": {
                  "id": 42
                }
              }
            ],
            "request": {
              "method": "GET",
              "path": "/orders/42"
            },
            "response": {
              "status": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": 42
              }
            }
          }
        ],
        "metadata": {
          "pactSpecification": {
            "version": "3.0.0"
          }
        }
      }
    ],
    "plugin-bridge": "/opt/janus/janus-plugin-bridge",
    "options": {
      "plugin-bridge": {
        "source": {
          "kind": "subprocess",
          "reference": "/srv/bridges/janus-plugin-bridge",
          "args": [
            "--quiet"
          ]
        },
        "limits": {
          "deadline-ms": 60000
        }
      }
    }
  },
  "expect": {
    "frames": {
      "verification/verify": {
        "options": {
          "plugin-bridge": {
            "source": {
              "kind": "subprocess",
              "reference": "/srv/bridges/janus-plugin-bridge",
              "args": [
                "--quiet"
              ]
            },
            "limits": {
              "deadline-ms": 60000
            }
          }
        }
      }
    },
    "outcome": "ok"
  }
}

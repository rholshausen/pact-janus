{
  "$format": "janus-conformance-case/1",
  "id": "provider/pending-failures-pass",
  "category": "provider",
  "title": "A pending pact's failures are in the result and fail nothing",
  "covers": [
    "verification.verify.pending-failures-pass"
  ],
  "why": "behavioural spec 'verify': 'A pending result's failure fails nothing: the summary's status already says what the run decided'.",
  "verifier": {
    "provider-url": "http://127.0.0.1:8080",
    "pacts": [
      {
        "consumer": {
          "name": "web-app"
        },
        "provider": {
          "name": "orders-api"
        },
        "interactions": [
          {
            "description": "get an order",
            "providerStates": [
              {
                "name": "an order exists",
                "params": {
                  "id": 42
                }
              }
            ],
            "request": {
              "method": "GET",
              "path": "/orders/42"
            },
            "response": {
              "status": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": 42
              }
            }
          }
        ],
        "metadata": {
          "pactSpecification": {
            "version": "3.0.0"
          }
        }
      }
    ]
  },
  "engine": {
    "events": [
      {
        "kind": "verification/interaction-result",
        "payload": {
          "interaction": {
            "contract": {
              "consumer": "web-app",
              "provider": "orders-api"
            },
            "index": 0,
            "description": "get an order"
          },
          "variant": "base",
          "status": "failed",
          "pending": true
        }
      }
    ],
    "summary": {
      "status": "verified",
      "pending": [
        true
      ],
      "variants": {
        "verified": 0,
        "failed": 1
      }
    }
  },
  "expect": {
    "outcome": "ok",
    "result": {
      "status": "verified",
      "results": [
        {
          "interaction": {
            "contract": {
              "consumer": "web-app",
              "provider": "orders-api"
            },
            "index": 0,
            "description": "get an order"
          },
          "variant": "base",
          "status": "failed",
          "pending": true
        }
      ]
    }
  }
}

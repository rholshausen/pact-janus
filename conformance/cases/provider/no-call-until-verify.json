{
  "$format": "janus-conformance-case/1",
  "id": "provider/no-call-until-verify",
  "category": "provider",
  "title": "Configuring a verifier and declaring its handlers sends nothing",
  "covers": [
    "verification.verifier.no-call-until-verify"
  ],
  "why": "behavioural spec 'verifier': 'Makes no protocol call and starts no engine when constructed, and neither does declaring a handler on it'.",
  "verifier": {
    "provider-url": "http://127.0.0.1:8080",
    "pacts": [
      {
        "consumer": {
          "name": "web-app"
        },
        "provider": {
          "name": "orders-api"
        },
        "interactions": [
          {
            "description": "get an order",
            "providerStates": [
              {
                "name": "an order exists",
                "params": {
                  "id": 42
                }
              }
            ],
            "request": {
              "method": "GET",
              "path": "/orders/42"
            },
            "response": {
              "status": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": 42
              }
            }
          }
        ],
        "metadata": {
          "pactSpecification": {
            "version": "3.0.0"
          }
        }
      }
    ],
    "state-handlers": [
      {
        "state": "an order exists",
        "setup": {}
      }
    ],
    "request-filters": [
      {}
    ]
  },
  "verify": false,
  "expect": {
    "ops": []
  }
}

{
  "$format": "janus-conformance-case/1",
  "id": "facade/pact-js-verifier-option-spellings",
  "category": "facade",
  "facade": "pact-js",
  "title": "pact-js's other spellings — providerBranch, validateSSL: false, headers as lines — become the same members as the spellings they stand for.",
  "covers": [],
  "rows": [
    { "note": "Documentation/provider-test-migration.md", "row": "`providerVersionBranch`, `providerBranch`" },
    { "note": "Documentation/provider-test-migration.md", "row": "`customProviderHeaders`" },
    {
      "note": "Documentation/provider-test-migration.md",
      "row": "`disableSslVerification`, `validateSSL: false`"
    }
  ],
  "why": "provider-test-migration.md, pact-js: `providerBranch` is `providerVersionBranch`'s; `customProviderHeaders` is the HTTP transport's `headers`, as a map or as `\"Name: value\"` lines; `validateSSL: false` is `disableSslVerification`'s `client.tls.insecure`.",
  "subjects": { "typescript": "pact-js-verifier-option-spellings.ts" },
  "engine": {},
  "expect": {
    "tests": [{ "test": "otherSpellings" }],
    "frames": {
      "verification/verify": {
        "source": {
          "kind": "broker",
          "broker": { "url": "https://broker.example" },
          "provider": "orders-api",
          "consumer-version-selectors": [{ "mainBranch": true }],
          "include-pending": false,
          "provider-branch": "main"
        },
        "target": {
          "transports": [
            {
              "transport": "http",
              "options": {
                "headers": { "X-Api-Key": "k-1" },
                "client": { "tls": { "insecure": true } },
                "base-url": "http://127.0.0.1:8080"
              }
            }
          ]
        },
        "options": { "report": {}, "publish": { "provider-version": "1.2.3", "branch": "main" } }
      }
    }
  }
}

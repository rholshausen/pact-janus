  "expect": {
    "tests": [{ "test": "brokerOptions" }],
    "frames": {
      "verification/verify": {
        "source": {
          "kind": "broker",
          "broker": { "url": "https://broker.example", "auth": { "kind": "bearer", "token": "t0k3n" } },
          "provider": "orders-api",
          "consumer-version-selectors": [{ "mainBranch": true }, { "tag": "prod", "latest": true }],
          "include-pending": true,
          "provider-branch": "main",
          "provider-tags": ["release"],
          "include-wip-since": "2026-01-01",
          "require-pacts": false
        },
        "target": {
          "transports": [
            {
              "transport": "http",
              "options": {
                "headers": { "X-Api-Key": "k-1" },
                "client": { "tls": { "insecure": true } },
                "base-url": "http://127.0.0.1:8080"
              }
            }
          ]
        },
        "options": {
          "report": {},
          "filter": { "consumers": ["web-app"] },
          "publish": {
            "provider-version": "1.2.3",
            "branch": "main",
            "tags": ["release"],
            "build-url": "https://ci.example/1"
          }
        }
      }
    }

{
  "$format": "janus-conformance-case/1",
  "id": "lifecycle/finalise-writes-contract",
  "category": "lifecycle",
  "title": "finalise names the contract file for the engine to merge into, which then holds the engine's text exactly, and ends the engine.",
  "covers": [
    "session.finalise.writes-contract-when-verified",
    "session.finalise.names-contract-file"
  ],
  "why": "behavioural spec 'finalise': the request carries 'write', naming '<contract directory>/<consumer>-<provider>.janus.json' as an absolute path, with 'mode' 'merge' (engine-protocol spec §8.2, ADR 0065). The engine's host writes the file, and the SDK writes none. Then ends the engine (engine-protocol spec §6).",
  "note": "The scripted engine writes its contract text to the file the request names, as the engine's host would, so the file holding these bytes shows the SDK named the right one. The engine's members are deliberately not in alphabetical order, its strings carry non-ASCII and characters a writer may escape, and its numbers are spelled as the engine spells them and a JavaScript or Java parser would not (1.0, an integer above 2^53, 1e+16): an SDK that rewrote the file would change them (ADR 0063 decision 6).",
  "engine": {
    "contract": {
      "$format": "janus-contract/1",
      "consumer": {
        "name": "web-app"
      },
      "provider": {
        "name": "orders-api"
      },
      "interactions": [
        {
          "description": "get an order",
          "transport": {
            "kind": "http",
            "mode": "passive"
          },
          "parts": {
            "response": {
              "body": {
                "shape": "object",
                "members": {
                  "note": {
                    "shape": "equality",
                    "example": "läuft \"quoted\" / ok"
                  },
                  "amount": {
                    "shape": "equality",
                    "example": 1.0
                  },
                  "id": {
                    "shape": "equality",
                    "example": 9007199254740993
                  },
                  "large": {
                    "shape": "equality",
                    "example": 1e+16
                  }
                }
              },
              "status": {
                "shape": "equality",
                "example": 200
              }
            }
          },
          "selection": {
            "variants": [
              {
                "id": "base"
              }
            ]
          }
        }
      ]
    },
    "contract-text": "{\"$format\":\"janus-contract/1\",\"consumer\":{\"name\":\"web-app\"},\"provider\":{\"name\":\"orders-api\"},\"interactions\":[{\"description\":\"get an order\",\"transport\":{\"kind\":\"http\",\"mode\":\"passive\"},\"parts\":{\"response\":{\"body\":{\"shape\":\"object\",\"members\":{\"note\":{\"shape\":\"equality\",\"example\":\"läuft \\\"quoted\\\" / ok\"},\"amount\":{\"shape\":\"equality\",\"example\":1.0},\"id\":{\"shape\":\"equality\",\"example\":9007199254740993},\"large\":{\"shape\":\"equality\",\"example\":1e+16}}},\"status\":{\"shape\":\"equality\",\"example\":200}}},\"selection\":{\"variants\":[{\"id\":\"base\"}]}}]}\n"
  },
  "steps": [
    {
      "execute": {
        "interaction": {
          "description": "get an order",
          "request": {
            "method": "GET",
            "path": "/orders/42"
          }
        }
      },
      "expect": {
        "outcome": "ok"
      }
    },
    {
      "finalise": {},
      "expect": {
        "outcome": "ok",
        "contract": {
          "written": true,
          "text": "{\"$format\":\"janus-contract/1\",\"consumer\":{\"name\":\"web-app\"},\"provider\":{\"name\":\"orders-api\"},\"interactions\":[{\"description\":\"get an order\",\"transport\":{\"kind\":\"http\",\"mode\":\"passive\"},\"parts\":{\"response\":{\"body\":{\"shape\":\"object\",\"members\":{\"note\":{\"shape\":\"equality\",\"example\":\"läuft \\\"quoted\\\" / ok\"},\"amount\":{\"shape\":\"equality\",\"example\":1.0},\"id\":{\"shape\":\"equality\",\"example\":9007199254740993},\"large\":{\"shape\":\"equality\",\"example\":1e+16}}},\"status\":{\"shape\":\"equality\",\"example\":200}}},\"selection\":{\"variants\":[{\"id\":\"base\"}]}}]}\n"
        }
      }
    }
  ],
  "expect": {
    "ops": [
      "engine/hello",
      "consumer-session/create",
      "consumer-session/add-interaction",
      "consumer-session/start-transport",
      "consumer-session/variants",
      "consumer-session/serve-variant",
      "consumer-session/report-variant",
      "consumer-session/finalise"
    ],
    "engine-closed": true,
    "frames": {
      "engine/hello": {
        "capabilities": {
          "contract-text": {}
        }
      },
      "consumer-session/finalise": {
        "write": {
          "mode": "merge"
        }
      }
    }
  }
}

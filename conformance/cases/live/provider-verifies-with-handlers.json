{
  "$format": "janus-conformance-case/1",
  "id": "live/provider-verifies-with-handlers",
  "category": "live",
  "title": "The real engine calls the test's state handler and request filter, and the run verifies",
  "covers": [
    "verification.verify.engine-calls-handlers"
  ],
  "why": "ADR 0055 decision 2: a handler is a loopback http hook the engine calls as it calls any other; the provider here answers only a request the filter signed.",
  "verifier": {
    "pacts": [
      {
        "consumer": {
          "name": "web-app"
        },
        "provider": {
          "name": "orders-api"
        },
        "interactions": [
          {
            "description": "get an order",
            "providerStates": [
              {
                "name": "an order exists",
                "params": {
                  "id": 42
                }
              }
            ],
            "request": {
              "method": "GET",
              "path": "/orders/42"
            },
            "response": {
              "status": 200,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "id": 42
              }
            }
          }
        ],
        "metadata": {
          "pactSpecification": {
            "version": "3.0.0"
          }
        }
      }
    ],
    "state-handlers": [
      {
        "state": "an order exists",
        "setup": {
          "returns": {
            "ready": true
          }
        }
      }
    ],
    "request-filters": [
      {
        "set": {
          "headers": {
            "x-token": [
              "t-1"
            ]
          }
        }
      }
    ]
  },
  "provider": {
    "routes": [
      {
        "method": "GET",
        "path": "/orders/42",
        "require-headers": {
          "x-token": "t-1"
        },
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "id": 42
        }
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "result": {
      "status": "verified"
    },
    "handler-calls": [
      {
        "handler": "state-1",
        "action": "setup",
        "params": {
          "id": 42
        }
      },
      {
        "handler": "request-filter-1"
      }
    ]
  }
}

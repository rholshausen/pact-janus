{
  "name": "pact-plugin-lines/compare-contents",
  "component": "pact-plugin-lines",
  "interface": "matcher",
  "calls": [
    {
      "op": "matcher/apply",
      "body": {
        "action": "pact-plugin-lines:compare-contents",
        "values": [
          {
            "content": "a\nb\n",
            "encoded": "text"
          }
        ],
        "config": {
          "arguments": [
            {
              "content-type": "text/x-lines",
              "expected": {
                "content": "a\nb\n",
                "encoded": "text"
              }
            }
          ]
        }
      },
      "expect": {
        "ok": {
          "results": [
            {
              "status": "ok"
            }
          ]
        }
      }
    },
    {
      "op": "matcher/apply",
      "body": {
        "action": "pact-plugin-lines:compare-contents",
        "values": [
          {
            "content": "a\nc\nd\n",
            "encoded": "text"
          }
        ],
        "config": {
          "arguments": [
            {
              "content-type": "text/x-lines",
              "expected": {
                "content": "x\nb\n",
                "encoded": "text"
              }
            }
          ]
        }
      },
      "expect": {
        "ok": {
          "results": [
            {
              "status": "error",
              "message": "$: Expected 2 line(s) but got 3; $[0]: Expected 'x' but got 'a'; $[1]: Expected 'b' but got 'c'",
              "mismatches": [
                {
                  "message": "Expected 2 line(s) but got 3",
                  "at": "$",
                  "expected": "2",
                  "actual": "3"
                },
                {
                  "message": "Expected 'x' but got 'a'",
                  "at": "$[0]",
                  "expected": "x",
                  "actual": "a"
                },
                {
                  "message": "Expected 'b' but got 'c'",
                  "at": "$[1]",
                  "expected": "b",
                  "actual": "c"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "op": "matcher/apply",
      "body": {
        "action": "pact-plugin-lines:compare-contents",
        "values": [
          {
            "content": "order-42\n",
            "encoded": "text"
          }
        ],
        "config": {
          "arguments": [
            {
              "content-type": "text/x-lines;charset=utf-8",
              "expected": {
                "content": "order-1\n",
                "encoded": "text"
              },
              "rules": {
                "$[0]": {
                  "combine": "AND",
                  "matchers": [
                    {
                      "match": "regex",
                      "regex": "order%-%d+"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "expect": {
        "ok": {
          "results": [
            {
              "status": "ok"
            }
          ]
        }
      }
    },
    {
      "op": "matcher/apply",
      "body": {
        "action": "pact-plugin-lines:compare-contents",
        "values": [
          {
            "content": "HELLO\n",
            "encoded": "text"
          }
        ],
        "config": {
          "arguments": [
            {
              "content-type": "application/x-lines+text",
              "expected": {
                "content": "aGVsbG8K",
                "encoded": "base64"
              },
              "plugin-configuration": {
                "interaction": {
                  "ignore-case": true
                },
                "pact": {}
              }
            }
          ]
        }
      },
      "expect": {
        "ok": {
          "results": [
            {
              "status": "ok"
            }
          ]
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.io/janus/protocol/v1/upgrade.schema.json",
  "title": "UpgradeOps",
  "description": "Request/result bodies for the upgrade/* operations (spec.md §8.4). Session-less: pure document-in, document-out.",
  "$defs": {
    "Pact": {
      "title": "Pact",
      "type": "object",
      "required": ["pact"],
      "properties": {
        "pact": {
          "type": "object",
          "description": "A v1-v4 pact document to convert to a Janus contract (rules in design 2.5)."
        },
        "options": { "type": "object" }
      }
    },
    "PactResult": {
      "title": "PactResult",
      "type": "object",
      "required": ["contract", "findings"],
      "properties": {
        "contract": {
          "type": "object",
          "description": "The converted Janus contract document."
        },
        "findings": {
          "type": "array",
          "description": "Lossy or judgement-call conversion spots, for 'janus upgrade' to show its work.",
          "items": {
            "title": "UpgradeFinding",
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "x-known-values": ["lossy-matching-rule", "example-became-variant", "unsupported-feature"]
              },
              "path": {
                "type": "string",
                "description": "JSON-path location in the source pact."
              },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
